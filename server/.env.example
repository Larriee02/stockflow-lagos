# Port for Express Server (Cloud hosts set this automatically)
PORT=5000

# Cloud PostgreSQL Connection String (from Neon.tech, Supabase, or Render)
# Leave blank locally to use embedded persistent PostgreSQL (server/pgdata)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: Restrict CORS to your frontend domain if hosted separately
# ALLOWED_ORIGIN=https://your-stockflow-app.onrender.com
